rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Función para verificar si el usuario es administrador o entrenador
    function isStaff() {
      return request.auth != null && (
        request.auth.token.email == "planeacionespolijic@gmail.com" ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && 
         (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'trainer'))
      );
    }

    // Reglas para fotos de perfil
    match /users/{userId}/{fileName} {
      // Lectura pública (o autenticada si prefieres)
      allow read: if true; 
      
      // Escritura solo por el dueño o admin
      allow write: if request.auth != null && (request.auth.uid == userId || isStaff())
                   && request.resource.size < 5 * 1024 * 1024 // Máximo 5MB
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Reglas para videos de análisis biomecánico y deportivo
    match /videoAnalysis/{userId}/{fileName} {
      // Permitir lectura a usuarios autenticados (dueño, entrenador o admin)
      allow read: if request.auth != null;
      
      // Permitir subida si el usuario está autenticado y es su video o es admin/entrenador
      allow write: if request.auth != null && (request.auth.uid == userId || isStaff())
                   && request.resource.size < 150 * 1024 * 1024 // Máximo 150MB
                   && request.resource.contentType.matches('video/.*');
    }
    
    // Denegar todo lo demás por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
